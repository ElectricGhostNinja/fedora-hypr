# Dotfiles root .gitignore — ignore everything, whitelist what to track.
# Works with the bare repo at ~/.dotfiles (alias: `dot`).

*
*/

# ---- home files ----
!.bashrc
!.zshrc
!.profile
!.gitignore
!.gitconfig
!README.md
!LICENSE
!install-fedora.sh
!.ssh/
!.ssh/config

# ---- .config (everything under it is tracked unless denied below) ----
!.config/
!.config/**

# ---- secrets / machine state - never publish ----
.config/BraveSoftware/
.config/cosmic/
.config/dconf/
.config/easyeffects/
.config/ml4w/
.config/opencode/
.config/mozilla/
.config/pulse/
.config/session/
.config/hypr.bak/
.config/hypr.bak*/
.config/hypr/*.bak*

# ---- untracked app / game state ----
.config/StardewValley/
.config/Vampire_Survivors/
.config/Vampire_Survivors_1014408504/
.config/Vampire_Survivors_Data/
.config/chromium/
.config/doom/
.config/emacs/
.config/qBittorrent/
.config/systemd/
.config/unity3d/
.config/winboat/

# ---- Firefox: track settings only, never profile data (cookies, logins, keys, history) ----
!.config/mozilla/
!.config/mozilla/firefox/
!.config/mozilla/firefox/profiles.ini
!.config/mozilla/firefox/installs.ini
.config/mozilla/firefox/Crash Reports/
.config/mozilla/firefox/Pending Pings/
.config/mozilla/firefox/Profile Groups/
!.config/mozilla/firefox/pir84aek.default-release/
.config/mozilla/firefox/pir84aek.default-release/*
!.config/mozilla/firefox/pir84aek.default-release/prefs.js
!.config/mozilla/firefox/pir84aek.default-release/extensions.json
!.config/mozilla/firefox/pir84aek.default-release/containers.json
!.config/mozilla/firefox/pir84aek.default-release/handlers.json
!.config/mozilla/firefox/nzw6l6h5.default/
.config/mozilla/firefox/nzw6l6h5.default/*
!.config/mozilla/firefox/nzw6l6h5.default/prefs.js
!.config/mozilla/firefox/nzw6l6h5.default/extensions.json
!.config/mozilla/firefox/nzw6l6h5.default/containers.json
!.config/mozilla/firefox/nzw6l6h5.default/handlers.json