# Multi-host SSH access for dotfiles (github/codeberg/gitlab)
Host github.com
    User git
    HostName github.com
    IdentityFile ~/.ssh/github_key
    IdentitiesOnly yes

Host codeberg.org
    User git
    HostName codeberg.org
    IdentityFile ~/.ssh/github_key
    IdentitiesOnly yes

Host gitlab.com
    User git
    HostName gitlab.com
    IdentityFile ~/.ssh/github_key
    IdentitiesOnly yes